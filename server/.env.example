# Copy to .env and fill in. Never commit .env.
# Claude: research and reading vendor replies. https://console.anthropic.com
ANTHROPIC_API_KEY=
# Google Places API (New), with billing enabled. https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=
# Optional
PORT=8787
# 127.0.0.1 works for the iOS simulator and Android emulator. Set 0.0.0.0 only
# to reach the server from a real phone on the same Wi-Fi.
HOST=127.0.0.1
